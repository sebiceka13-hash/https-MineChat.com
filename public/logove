<!DOCTYPE html>
<html lang="sq">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Mine Chat — Zgjidh logon</title>
<style>
  :root { --bg:#0b1020; --panel:#121828; --panel-2:#1a2136; --border:#262f47; --text:#e8ebf2; --muted:#8b93a7; --accent:#4c8dff; }
  * { box-sizing:border-box; }
  body {
    margin:0; padding:34px 20px; background:var(--bg); color:var(--text);
    font:15px/1.6 "Segoe UI", system-ui, sans-serif; text-align:center;
  }
  h1 { font-size:24px; margin:0 0 6px; }
  p.sub { color:var(--muted); margin:0 0 30px; }
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:16px; max-width:1000px; margin:0 auto; }
  .opt {
    background:var(--panel); border:1px solid var(--border); border-radius:16px;
    padding:20px 14px 16px; cursor:pointer; transition:border-color .18s, transform .16s, background .18s;
  }
  .opt:hover { border-color:var(--accent); transform:translateY(-3px); background:var(--panel-2); }
  .opt.sel { border-color:var(--accent); background:#1e2740; box-shadow:0 0 0 3px rgba(76,141,255,.22); }
  .box {
    width:96px; height:96px; margin:0 auto 14px; border-radius:26px; display:grid; place-items:center;
    background:linear-gradient(145deg,var(--accent),#7c3aed); box-shadow:0 12px 28px rgba(76,141,255,.35);
  }
  .box svg { width:62%; height:62%; color:#fff; overflow:visible; }
  .name { font-size:14.5px; font-weight:600; }
  .desc { color:var(--muted); font-size:12.5px; margin-top:3px; }
  #done {
    max-width:1000px; margin:26px auto 0; padding:14px; border-radius:12px;
    background:#0e2a1c; border:1px solid #1f6b45; color:#8ef0b8; display:none; font-size:14.5px;
  }
</style>
</head>
<body>

<h1>Zgjidh logon</h1>
<p class="sub">Kliko mbi logon që të pëlqen</p>

<div class="grid" id="grid"></div>

<div id="done"></div>

<script>
const S = 'fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"';

const OPTIONS = [
  { n: "Fushë bisede + yll", d: "Aktualja", s: `<svg viewBox="0 0 48 48" ${S}><path d="M23.5 5.6C13.6 5.6 5.6 12.8 5.6 21.8c0 5 2.5 9.4 6.4 12.3-.3 3-1.4 5.7-3.2 8 3.7-.8 7.2-2.4 9.9-4.7 1.4.3 3 .4 4.6.4 9.9 0 17.9-7.2 17.9-16S33.4 5.6 23.5 5.6Z"/><path d="M38.6 6.8c.5 1.9 1.3 2.7 3.2 3.2-1.9.5-2.7 1.3-3.2 3.2-.5-1.9-1.3-2.7-3.2-3.2 1.9-.5 2.7-1.3 3.2-3.2Z"/></svg>` },
  { n: "Yll i vetëm", d: "I thjeshtë dhe i pastër", s: `<svg viewBox="0 0 48 48" ${S}><path d="M24 6l4.6 10.4L39 21l-10.4 4.6L24 36l-4.6-10.4L9 21l10.4-4.6L24 6Z"/></svg>` },
  { n: "Diamant", d: "I shkëlqyer", s: `<svg viewBox="0 0 48 48" ${S}><path d="M24 5L8 17l16 26 16-26L24 5Z"/><path d="M8 17h32"/><path d="M16 17l8 26 8-26"/></svg>` },
  { n: "Fushë bisede", d: "Vetëm fusha", s: `<svg viewBox="0 0 48 48" ${S}><path d="M24 6C14.1 6 6 12.8 6 21.3c0 8.5 8.1 15.3 18 15.3 1.6 0 3.2-.1 4.7-.5 2.7 2.2 6.1 3.8 10 4.4-.9-2.6-1.4-5.3-1.3-8 3-2.7 4.9-6.6 4.9-11.2C42.3 12.8 33.9 6 24 6Z"/></svg>` },
  { n: "Fushë dysh", d: "Dy biseda", s: `<svg viewBox="0 0 48 48" ${S}><path d="M10 8h20a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H17l-6 5v-5h-1a5 5 0 0 1-5-5V13a5 5 0 0 1 5-5Z"/><path d="M18 34h16a5 5 0 0 1 5 5v6l-5-4H18a5 5 0 0 1-5-5"/></svg>` },
  { n: "Gjeometri", d: "Trekëndësha", s: `<svg viewBox="0 0 48 48" ${S}><path d="M24 7l16 28H8L24 7Z"/><circle cx="24" cy="26" r="4.5"/></svg>` },
  { n: "Truest me yll", d: "Bisedë + yll", s: `<svg viewBox="0 0 48 48" ${S}><path d="M24 7C14.7 7 7 13.3 7 21.2c0 4.4 2.3 8.3 6 10.9-.2 2.8-1.2 5.3-2.9 7.3 3.4-.7 6.6-2.1 9.1-4.1 1.5.3 3.1.4 4.8.4 9.3 0 16.9-6.3 16.9-14.5S33.3 7 24 7Z"/><path d="M40 9l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2Z"/></svg>` },
  { n: "Shkëndija", d: "E shpejtë", s: `<svg viewBox="0 0 48 48" ${S}><path d="M27 5L12 26h10l-1 17 15-21H26l1-17Z"/></svg>` }
];

const grid = document.getElementById("grid");
const done = document.getElementById("done");
let picked = null;

for (const o of OPTIONS) {
  const el = document.createElement("div");
  el.className = "opt";
  el.innerHTML =
    '<div class="box">' + o.s + '</div>' +
    '<div class="name">' + o.n + '</div>' +
    '<div class="desc">' + o.d + '</div>';

  el.addEventListener("click", () => {
    picked = o;
    grid.querySelectorAll(".opt").forEach((n) => n.classList.remove("sel"));
    el.classList.add("sel");
    done.style.display = "block";
    done.textContent = "Zgjidh: " + o.n + " — shkruaj emrin te unë dhe e vendos.";
  });
  grid.appendChild(el);
}
</script>

</body>
</html>
